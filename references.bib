	pages = {68--74},
	file = {Full Text:/Users/gchure/Zotero/storage/B27LEBZY/Dey et al. - 2020 - Dependence of bacterial growth rate on dynamic tem.pdf:application/pdf},
}

@article{knapp2022,
	title = {The {Effects} of {Temperature} on {Cellular} {Physiology}},
	volume = {51},

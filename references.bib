@article{milo2013,
	title = {What is the total number of protein molecules per cell volume? {A} call to rethink some published values},
	volume = {35},
	issn = {1521-1878},
	shorttitle = {What is the total number of protein molecules per cell volume?},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/bies.201300066},
	doi = {10.1002/bies.201300066},
	abstract = {Novel methods such as mass-spectrometry enable a view of the proteomes of cells in unprecedented detail. Recently, these efforts have culminated in quantitative measurements of the number of copies per cell for most expressed proteins in organisms ranging from bacteria to mammalian cells. Here, we estimate the expected total number of proteins per unit of cell volume using known parameters related to the composition of cells such as the fraction of cell mass that is protein, and the average protein length. Using simple arguments, we estimate a range of 2–4 million proteins per cubic micron (i.e. 1 fL) in bacteria, yeast, and mammalian cells. Interestingly, we find that measured values that are reported for fission yeast and mammalian cells are often about 3–10 times lower. We discuss this apparent discrepancy and how to use the estimate as benchmark to recalibrate proteome-wide quantitative censuses or to revisit assumptions about cell composition.},
	language = {en},
	number = {12},
	urldate = {2021-10-21},
	journal = {BioEssays},
	author = {Milo, Ron},
	year = {2013},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/bies.201300066},
	keywords = {mass spectrometry, protein abundance, cell biology by the numbers, protein copy numbers, proteins per cell, proteomic calibration, quantitative proteomics},
	pages = {1050--1055},
	file = {Full Text PDF:/Users/gchure/Zotero/storage/5P932WNN/Milo - 2013 - What is the total number of protein molecules per .pdf:application/pdf;Snapshot:/Users/gchure/Zotero/storage/U2Q9QKPS/bies.html:text/html},
}

@article{basan2015,
	title = {Inflating bacterial cells by increased protein synthesis},
	volume = {11},
	issn = {1744-4292},
	url = {https://www.embopress.org/doi/full/10.15252/msb.20156178},
	doi = {10.15252/msb.20156178},
	abstract = {Abstract Understanding how the homeostasis of cellular size and composition is accomplished by different organisms is an outstanding challenge in biology. For exponentially growing Escherichia coli cells, it is long known that the size of cells exhibits a strong positive relation with their growth rates in different nutrient conditions. Here, we characterized cell sizes in a set of orthogonal growth limitations. We report that cell size and mass exhibit positive or negative dependences with growth rate depending on the growth limitation applied. In particular, synthesizing large amounts of ?useless? proteins led to an inversion of the canonical, positive relation, with slow growing cells enlarged 7- to 8-fold compared to cells growing at similar rates under nutrient limitation. Strikingly, this increase in cell size was accompanied by a 3- to 4-fold increase in cellular DNA content at slow growth, reaching up to an amount equivalent to {\textasciitilde}8 chromosomes per cell. Despite drastic changes in cell mass and macromolecular composition, cellular dry mass density remained constant. Our findings reveal an important role of protein synthesis in cell division control.},
	number = {10},
	urldate = {2020-03-24},
	journal = {Molecular Systems Biology},
	author = {Basan, Markus and Zhu, Manlu and Dai, Xiongfeng and Warren, Mya and Sévin, Daniel and Wang, Yi-Ping and Hwa, Terence},
	month = oct,
	year = {2015},
	note = {Publisher: John Wiley \& Sons, Ltd},
	keywords = {cell size, cell volume, growth rate, cell division, cellular DNA},
	pages = {836},
	file = {Full Text:/Users/gchure/Zotero/storage/QBIZXVX4/Basan et al. - 2015 - Inflating bacterial cells by increased protein syn.pdf:application/pdf},
}


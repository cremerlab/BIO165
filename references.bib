	doi = {10.1016/j.tim.2005.03.008},
	abstract = {The small nucleotide ppGpp acts as a global regulator of gene expression in bacteria. Proteomic analysis of cells lacking ppGpp has shown that this nucleotide might affect many more genes than previously anticipated. These findings and others suggest that ppGpp causes a redirection of transcription so that genes important for starvation survival and virulence are favoured at the expense of those required for growth and proliferation. In addition, new insights into the mechanism by which ppGpp affects gene expression have been achieved owing to in vitro studies of ppGpp function, complemented by structural studies of the ppGpp–RNA polymerase complex.},
	language = {en},
	number = {5},
	urldate = {2021-11-02},

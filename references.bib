@article{devries2010,
	series = {Special section "{DNA} and {Chromosomes}: {Physical} and {Biological} {Approaches}"},
	title = {{DNA} condensation in bacteria: {Interplay} between macromolecular crowding and nucleoid proteins},
	volume = {92},
	issn = {0300-9084},
	shorttitle = {{DNA} condensation in bacteria},
	url = {https://www.sciencedirect.com/science/article/pii/S0300908410002555},
	doi = {10.1016/j.biochi.2010.06.024},
	abstract = {The volume of a typical Eschericia coli nucleoid is roughly 104 times smaller than the volume of a freely coiling linear DNA molecule with the same length as the E. coli genome. We review the main forces that have been suggested to contribute to this compaction factor: macromolecular crowding (that “pushes” the DNA together), DNA charge neutralization by various polycationic species (that “glues” the DNA together), and finally, DNA deformations due to DNA supercoiling and nucleoid proteins. The direct contributions of DNA supercoiling and nucleoid proteins to the total compaction factor are probably small. Instead, we argue that the formation of the bacterial nucleoid can be described as a consequence of the influence of macromolecular crowding on thick, supercoiled protein-DNA fibers, that have been partly charge neutralized by small multivalent cations.},
	number = {12},
	urldate = {2023-10-13},
	journal = {Biochimie},
	author = {de Vries, Renko},
	month = dec,
	year = {2010},
	keywords = {Bacterial nucleoid proteins, DNA condensation, Macromolecular crowding},
	pages = {1715--1721},
	file = {ScienceDirect Full Text PDF:/Users/gchure/Zotero/storage/TLP6UUNT/de Vries - 2010 - DNA condensation in bacteria Interplay between ma.pdf:application/pdf;ScienceDirect Snapshot:/Users/gchure/Zotero/storage/5EMEMH9G/S0300908410002555.html:text/html},
}

@article{akabayov2013,
	title = {Impact of macromolecular crowding on {DNA} replication},
	volume = {4},
	copyright = {2013 Springer Nature Limited},
	issn = {2041-1723},
	url = {https://www.nature.com/articles/ncomms2620},
	doi = {10.1038/ncomms2620},
	abstract = {Enzymatic activities in vivo occur in a crowded environment composed of many macromolecules. This environment influences DNA replication by increasing the concentration of the constituents, desolvation, decreasing the degrees of freedom for diffusion and hopping of proteins onto DNA, and enhancing binding equilibria and catalysis. However, the effect of macromolecular crowding on protein structure is poorly understood. Here we examine macromolecular crowding using the replication system of bacteriophage T7 and we show that it affects several aspects of DNA replication; the activity of DNA helicase increases and the sensitivity of DNA polymerase to salt is reduced. We also demonstrate, using small-angle X-ray scattering analysis, that the complex between DNA helicase and DNA polymerase/trx is far more compact in a crowded environment. The highest enzymatic activity corresponds to the most compact structure. Better knowledge of the effect of crowding on structure and activity will enhance mechanistic insight beyond information obtained from NMR and X-ray structures.},
	language = {en},
	number = {1},
	urldate = {2023-10-13},
	journal = {Nature Communications},
	author = {Akabayov, Barak and Akabayov, Sabine R. and Lee, Seung-Joo and Wagner, Gerhard and Richardson, Charles C.},
	month = mar,
	year = {2013},
	note = {Number: 1
Publisher: Nature Publishing Group},
	keywords = {Biophysics, DNA replication},
	pages = {1615},
	file = {Full Text PDF:/Users/gchure/Zotero/storage/2PFM8UCG/Akabayov et al. - 2013 - Impact of macromolecular crowding on DNA replicati.pdf:application/pdf},
}

@article{garenne2020,

	file = {Knapp and Huang - 2022 - The Effects of Temperature on Cellular Physiology.pdf:/Users/gchure/Zotero/storage/IUIK966U/Knapp and Huang - 2022 - The Effects of Temperature on Cellular Physiology.pdf:application/pdf},
}

@article{morgenstein2015a,

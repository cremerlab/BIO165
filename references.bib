	note = {Type: article},
	keywords = {B.subtilis, bacterial functions, bacterial metabolism, bacterial physiology, cell shape, cell size, E.coli, rod-like},
	file = {Full Text PDF:/Users/gchure/Zotero/storage/CVBTFZU7/Teeffelen and Renner - 2018 - Recent advances in understanding how rod-like bact.pdf:application/pdf},
}

